[
  {
    "$id": "receipt-web",
    "name": "Receipt Web",
    "logging": true,
    "framework": "react",
    "timeout": 30,
    "installCommand": "npm ci",
    "buildCommand": "npm run build",
    "outputDirectory": "./dist",
    "buildSpecification": "s-2vcpu-2gb",
