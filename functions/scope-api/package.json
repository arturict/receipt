{
  "name": "receipt-scope-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:live": "node scripts/live-smoke.mjs",
    "verify": "npm run lint && npm test && node --check scripts/live-smoke.mjs"
  },
  "dependencies": {
    "node-appwrite": "27.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
